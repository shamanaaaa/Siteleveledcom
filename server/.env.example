# ── SMTP configuration ──────────────────────────────────────
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   Use an App Password (not your normal Gmail password):
#   https://myaccount.google.com/apppasswords

# Custom domain / other SMTP:
#   SMTP_HOST=mail.yourdomain.com
#   SMTP_PORT=465
#   SMTP_SECURE=true

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# The email address used to send (must match SMTP_USER for most providers)
SMTP_USER=your@email.com
SMTP_PASS=your-app-password

# (optional) Display name in From header – defaults to SMTP_USER
SMTP_FROM=SiteLeveled <your@email.com>

# Where new leads are delivered (your business inbox)
MAIL_TO=domansro@gmail.com

# Server port (default: 3001)
PORT=3001

# ── SEO audit (/seo-audit page, runs Unlighthouse) ──────────
# All optional – defaults shown.
# If set, customers must enter this code to start an audit (leave empty = public tool)
SEO_AUDIT_ACCESS_CODE=
# Max pages scanned per audit
SEO_AUDIT_MAX_PAGES=15
# Audits one IP may start per 24h (re-opening a site scanned in the last hour doesn't count)
SEO_AUDIT_DAILY_LIMIT=1
# Max audits waiting in the queue
SEO_AUDIT_MAX_QUEUE=10
# Kill an audit after this many minutes
SEO_AUDIT_TIMEOUT_MIN=10
# Delete reports older than this
SEO_AUDIT_RETENTION_DAYS=30
# Where reports are stored (default: server/audits)
# SEO_AUDIT_DIR=/var/lib/siteleveled/audits
